:root {
    --primary: #4A3B32;
    --secondary: #8C6D53;
    --accent: #D9B89A;
    --bg-light: #F9F6F0;
    --text-dark: #2C221E;
    --white: #FFFFFF;
}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
body {
    background-color: var(--bg-light);
    color: var(--text-dark);
    line-height: 1.6;
}
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--primary);
    padding: 1rem 5%;
    color: var(--white);
    position: sticky;
    top: 0;
    z-index: 1000;
}
.logo {
    font-size: 1.5rem;
    font-weight: bold;
    letter-spacing: 1px;
}
.nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
}
.nav-links a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
}
.nav-links a:hover, .nav-links a.active {
    color: var(--white);
    border-bottom: 2px solid var(--accent);
}
.slider-container {
    position: relative;
    max-width: 100%;
    height: 450px;
    overflow: hidden;
    background: #000;
}
.slide {
    display: none;
    position: absolute;
    width: 100%;
    height: 100%;
}
.slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
}
.slide-text {
    position: absolute;
    bottom: 20%;
    left: 10%;
    color: var(--white);
    font-size: 2.5rem;
    font-weight: bold;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.7);
    background: rgba(0,0,0,0.4);
    padding: 10px 20px;
    border-radius: 5px;
}
.prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    padding: 16px;
    color: white;
    font-weight: bold;
    font-size: 18px;
    background-color: rgba(0,0,0,0.5);
    border: none;
    transition: 0.3s;
    user-select: none;
}
.next { right: 0; }
.prev { left: 0; }
.prev:hover, .next:hover { background-color: rgba(0,0,0,0.8); }

/* --- Animación de Transición para el Slider --- */
.fade {
    animation-name: fadeEffect;
    animation-duration: 1.5s;
}
@keyframes fadeEffect {
    from { opacity: 0.4; }
    to { opacity: 1; }
}

.info-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5rem 10%;
    gap: 4rem;
}
.info-section.reverse {
    flex-direction: row-reverse;
    background-color: var(--white);
}
.info-content { flex: 1; }
.info-content h2 {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 1rem;
}
.info-media {
    flex: 1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}
.info-media img, .info-media video {
    width: 100%;
    display: block;
}
.page-content {
    padding: 4rem 10%;
    min-height: 70vh;
}
.page-content h1 {
    font-size: 2.5rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
}
.page-intro {
    font-size: 1.1rem;
    color: var(--secondary);
    margin-bottom: 3rem;
}
.grid-gallery, .material-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
}
.card, .material-item {
    background: var(--white);
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
}
.card:hover, .material-item:hover { transform: translateY(-5px); }
.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 5px;
    margin-bottom: 1rem;
}
.contact-section, .contact-container {
    max-width: 600px;
    margin: 4rem auto;
    background: var(--white);
    padding: 3rem;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}
.contact-section h2 {
    text-align: center;
    color: var(--primary);
    margin-bottom: 2rem;
}
.form-group { margin-bottom: 1.5rem; }
.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--primary);
}
.form-group input, .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    font-size: 1rem;
}
.btn-submit {
    display: block;
    width: 100%;
    background-color: var(--secondary);
    color: var(--white);
    padding: 0.75rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease;
}
.btn-submit:hover { background-color: var(--primary); }
footer {
    background-color: var(--primary);
    color: var(--white);
    text-align: center;
    padding: 2rem;
    margin-top: 4rem;
}
.footer-content p {
    margin: 0.3rem 0;
    font-size: 0.95rem;
    color: var(--accent);
}
